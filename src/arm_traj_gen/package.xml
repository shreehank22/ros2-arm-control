<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>arm_traj_gen</name>
  <version>0.0.1</version>

  <description>
    Cartesian and joint trajectory generation with DLS inverse kinematics for the Franka FR3
  </description>

  <maintainer email="shreehan1912@gmail.com">
    Shreehan Kate
  </maintainer>

  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>arm_kinodynamics</depend>
  <depend>rclcpp</depend>
  <exec_depend>arm_sim</exec_depend>
  <depend>sensor_msgs</depend>
  <depend>pinocchio</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>rclcpp_action</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>